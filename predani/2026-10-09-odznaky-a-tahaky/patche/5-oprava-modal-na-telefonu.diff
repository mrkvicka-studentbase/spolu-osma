+/* ODPOVED 8. 10., bod 2: okna na telefonu přes celou šířku, přilepená dole. Pozdější `.modal { width: … }`
+   (dialog 24 px) a `.modal--tahak` přebíjely mobilní pravidlo a okno bylo posunuté doleva. Karta odznaku má vlastní rozměry. */
+@media (max-width: 40rem) {
+  .modal:not(.modal--karty-odznaku) {
+    width: 100%;
+    max-width: 100%;
+    margin: auto 0 0;
+    border-radius: var(--polomer-panel) var(--polomer-panel) 0 0;
+  }
