+/* ==========================================================================
+   Redesign odznaků a karet (8. 10., návrh designérky; Pavel: „Strašně se inspiruj tímhle stylem, drž se ho.“)
+   odznaky.js (htmlOdznaku), odznaky-ui.js (dlaždice v přehledu odznaků, řádek na přehledu),
+   odznaky-karty.js (karta nového odznaku i taháku). Nahrazuje styly odznaků z R62 a karty z 6. 10.
+   Karta je tmavá v obou motivech; dlaždice se řídí tokeny motivu.
+   ========================================================================== */
+
+/* --- Odznak: rám, pruhovaný kruh, jádro a líc (odlesk + přejíždějící lesk). Tvar clip-path, tón proměnnými. --- */
+.odz {
+  --s: 96px; --odz-ram: #141A33; --odz-tvar: circle(50%);
+  position: relative; display: inline-block; flex: none; width: var(--s); height: var(--s); vertical-align: middle;
+  filter: drop-shadow(0 7px 10px rgb(20 26 51 / 0.3));
+  transition: transform 0.35s cubic-bezier(.3, 1.6, .5, 1);
+}
+.odz__ram, .odz__pruhy, .odz__jadro, .odz__lic { position: absolute; display: block; clip-path: var(--odz-tvar); }
+.odz__ram { inset: 0; background: var(--odz-ram); }
+.odz__pruhy { inset: 5%; background: repeating-conic-gradient(from 0deg, var(--odz-hi) 0 6deg, var(--odz-lo) 6deg 12deg); }
+.odz__jadro { inset: 10%; background: var(--odz-ram); }
+.odz__lic {
+  inset: 13%; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center;
+  background: radial-gradient(circle at 30% 22%, var(--odz-hi), var(--odz-mid) 48%, var(--odz-lo));
+  color: var(--odz-ink); font-family: var(--pismo-rodina); line-height: 1;
+}
+.odz__lic::before { content: ""; position: absolute; inset: 0; pointer-events: none;
+  background: linear-gradient(155deg, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0) 40%); }
+.odz__lic::after { content: ""; position: absolute; top: -20%; bottom: -20%; left: -70%; width: 40%; pointer-events: none; transform: skewX(-20deg);
+  background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.8), rgb(255 255 255 / 0)); }
+
+.odz--kruh { --odz-tvar: circle(50%); }
+.odz--sestiuhelnik { --odz-tvar: polygon(50% 0, 94% 25%, 94% 75%, 50% 100%, 6% 75%, 6% 25%); }
+.odz--stit { --odz-tvar: polygon(50% 0, 95% 13%, 95% 56%, 50% 100%, 5% 56%, 5% 13%); }
+
+.odz--zlata { --odz-hi: #FFF0A8; --odz-mid: #F5C21B; --odz-lo: #C98A00; --odz-ink: #141A33; }
+.odz--zelena { --odz-hi: #A5F7D4; --odz-mid: #1FC27E; --odz-lo: #0B8A55; --odz-ink: #0D2233; }
+.odz--modra { --odz-hi: #9CC0FF; --odz-mid: #2F6FEE; --odz-lo: #1C4FC4; --odz-ink: #FFFFFF; }
+
+/* zamčený: šedé tóny, bez lesku, kulatý zámek vpravo dole (pod 56 px jen šedý) */
+.odz--zamceno { --odz-hi: #F4F5F9; --odz-mid: #E1E5EE; --odz-lo: #C5CBD8; --odz-ink: #7B8398; --odz-ram: #AAB1C2; filter: none; }
+.odz--zamceno .odz__lic::after { display: none; }
+.odz__zamek {
+  position: absolute; right: 0; bottom: 0; width: 32%; height: 32%; box-sizing: border-box; border-radius: 50%;
+  display: flex; align-items: center; justify-content: center;
+  background: #141A33; color: #FFFFFF; border: 2px solid var(--odz-zamek-lem, #F3F5FB);
+}
+.odz__zamek svg { width: 60%; height: 60%; }
+@media screen {
+  :root[data-motiv="tmavy"] .odz--zamceno { --odz-hi: #4A5674; --odz-mid: #36415C; --odz-lo: #283149; --odz-ink: #A9B4CB; --odz-ram: #5A6683; }
+  :root[data-motiv="tmavy"] .odz__zamek { background: #E2E8F0; color: #0F172A; }
+}
+
+/* znaky (currentColor) */
+.odz__hvezda { width: calc(var(--s) * 0.3); height: calc(var(--s) * 0.3); }
+.odz__hvezda--velka { width: calc(var(--s) * 0.46); height: calc(var(--s) * 0.46); }
+.odz__zkratka { font-weight: 800; font-size: calc(var(--s) * 0.15); letter-spacing: 0.06em; margin-top: calc(var(--s) * 0.02); }
+.odz__cislo { font-weight: 800; font-size: calc(var(--s) * 0.28); }
+.odz__cislo--maly { font-size: calc(var(--s) * 0.2); letter-spacing: -0.01em; }
+.odz__sipky { width: calc(var(--s) * 0.3); height: calc(var(--s) * 0.13); margin-top: calc(var(--s) * 0.02); }
+.odz__pohar { width: calc(var(--s) * 0.42); height: calc(var(--s) * 0.42); }
+.odz__ikona { width: calc(var(--s) * 0.4); height: calc(var(--s) * 0.4); }
+.odz__karticky {
+  position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
+  width: calc(var(--s) * 0.3); height: calc(var(--s) * 0.38); margin: calc(var(--s) * 0.06) calc(var(--s) * 0.06) 0 0;
+  border: calc(var(--s) * 0.03) solid currentColor; border-radius: calc(var(--s) * 0.06);
+  font-weight: 800; font-size: calc(var(--s) * 0.17); background: var(--odz-mid);
+}
+.odz__karticky::before { content: ""; position: absolute; inset: calc(var(--s) * -0.03); z-index: -1; opacity: 0.75;
+  border: calc(var(--s) * 0.03) solid currentColor; border-radius: calc(var(--s) * 0.06); transform: translate(24%, -18%); }
+.odz__karticky--maly { width: calc(var(--s) * 0.36); font-size: calc(var(--s) * 0.12); }
+
+.odz--maly { filter: drop-shadow(0 2px 3px rgb(20 26 51 / 0.25)); }
+.odz--maly.odz--zamceno { filter: none; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .odz:not(.odz--maly):not(.odz--zamceno) .odz__lic::after { animation: odz-lesk 5.5s ease-in-out infinite; }
+}
+@keyframes odz-lesk { 0%, 60% { left: -70%; } 90%, 100% { left: 140%; } }
+
+/* --- Přehled odznaků (modal): dlaždice Získáno (bílá) / Zamčeno (čárkovaná), nadpisy sekcí velkými písmeny ---- */
+.modal--odznaky { width: min(62rem, calc(100% - 2rem)); background: var(--barva-pozadi); }
+.modal--odznaky .modal__panel { background: var(--barva-pozadi); gap: var(--mezera-4); }
+/* telefon: spodní panel přes celou šířku (obecné .modal má na úzkém displeji šířku 100 % - 2rem bez okraje vlevo) */
+@media (max-width: 40rem) { .modal--odznaky { width: 100%; max-width: 100%; } }
+.odznaky__nadpis { margin: var(--mezera-4) 0 0; font-size: 0.8125rem; font-weight: var(--pismo-vaha-tucne); line-height: 1.3;
+  letter-spacing: 0.14em; text-transform: uppercase; color: var(--barva-text-tlumeny); }
+.odznaky { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr)); gap: var(--mezera-4); margin: 0; }
+.odznak {
+  display: flex; flex-direction: column; align-items: center; gap: 12px; margin: 0; padding: 22px 12px 18px; min-width: 0;
+  border-radius: 20px; text-align: center; font: inherit; color: inherit;
+  transition: transform 0.25s ease, box-shadow 0.25s ease;
+}
+.odznak .odz { --s: 96px; }
+.odznak--ziskany { background: var(--barva-povrch); border: 1px solid var(--barva-okraj); box-shadow: 0 2px 6px rgb(20 26 51 / 0.06); cursor: pointer; }
+.odznak--chybi { --odz-zamek-lem: var(--barva-pozadi); background: color-mix(in srgb, var(--barva-povrch) 40%, transparent); border: 1px dashed var(--barva-okraj-silny); }
+.odznak--ziskany:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgb(20 26 51 / 0.14); }
+.odznak--ziskany:hover .odz { transform: rotate(-7deg) scale(1.08); }
+.odznak--tlacitko:focus-visible { outline: 3px solid var(--barva-fokus); outline-offset: 3px; }
+.odznak:nth-child(6n+2) .odz__lic::after { animation-delay: 0.5s; }
+.odznak:nth-child(6n+3) .odz__lic::after { animation-delay: 1s; }
+.odznak:nth-child(6n+4) .odz__lic::after { animation-delay: 1.5s; }
+.odznak:nth-child(6n+5) .odz__lic::after { animation-delay: 2s; }
+.odznak:nth-child(6n) .odz__lic::after { animation-delay: 2.5s; }
+.odznak__text { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
+.odznak__stav { font-size: 0.625rem; font-weight: var(--pismo-vaha-tucne); line-height: 1.2; letter-spacing: 0.14em; text-transform: uppercase; }
+.odznak--ziskany .odznak__stav { color: var(--barva-zelena-text); }
+.odznak--chybi .odznak__stav { color: var(--barva-text-tlumeny); }
+.odznak__nazev { font-size: 0.9375rem; font-weight: var(--pismo-vaha-tucne); line-height: 1.25; color: var(--barva-text); overflow-wrap: anywhere; }
+.odznak__popis { font-size: 0.78125rem; line-height: 1.45; color: var(--barva-text-tlumeny); text-wrap: pretty; }
+@media screen { :root[data-motiv="tmavy"] .odznak--ziskany:hover { box-shadow: 0 14px 28px rgb(0 0 0 / 0.4); } }
+@media (prefers-reduced-motion: reduce) { .odznak, .odz { transition: none; } }
+
+/* --- Řádek „Odznaky: x z N“ na přehledu (rozložení sdílí i řádek taháků) ------------------------------------ */
+.odznaky-radek { display: flex; flex-direction: column; gap: var(--mezera-2); width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer; }
+.odznaky-radek__hlavicka { display: flex; justify-content: space-between; align-items: baseline; gap: var(--mezera-2); }
+.odznaky-radek__pas { display: flex; gap: var(--mezera-2); overflow: hidden; }
+.odznaky-radek__pas:has(.odz) { padding-bottom: 4px; }
+.odznaky-radek__pas .odz { --s: 40px; }
+
+/* --- Karta nového odznaku a taháku: tmavá scéna, neonový titulek, 3D karta rub → líc ------------------------ */
+.modal--karty-odznaku {
+  width: min(28rem, calc(100% - 1rem)); max-height: calc(100% - 1rem); margin: auto; overflow: visible;
+  background: transparent; box-shadow: none; color: #FFFFFF; border-radius: 0;
+}
+.modal--karty-odznaku::backdrop {
