# Vzor pro .env (zkopírujte jako .env do kořene repa a doplňte hodnoty).
# .env je v .gitignore — NIKDY ho necommitujte. Nic z tohoto souboru nepatří do web/.

# Adresa projektu: Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=

# Secret key (sb_secret_…) nebo starý service_role JWT: Project Settings → API Keys.
# Obchází RLS! Používá jen seed (supabase/seed/seed-lekce.mjs).
SUPABASE_SERVICE_KEY=

# Reference projektu = část URL před .supabase.co
SUPABASE_PROJECT_REF=

# Heslo databáze: Project Settings → Database (při neznámém heslu „Reset database password")
SUPABASE_DB_PASSWORD=

# Připojení k Postgresu pro migrace a SQL (supabase/skripty/migrovat.mjs, sql.mjs):
# Project Settings → Database → Connection string → Session pooler (URI), [YOUR-PASSWORD] nahradit heslem.
# Tvar: postgresql://postgres.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
